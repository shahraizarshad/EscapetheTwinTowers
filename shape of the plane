//  shape & color helpers // ye enhancement part h shop walay code ka the one already in main.cpp.
extern float bgTime;       // animation clock from main game
sf::Transform gXf;         // rotation transform applied while drawing the plane

inline void box(sf::RenderWindow& w, float x, float y, float wd, float ht, sf::Color c) {
    sf::RectangleShape r({wd, ht});
    r.setPosition({x, y});
    r.setFillColor(c);
    w.draw(r, sf::RenderStates(gXf));
}

inline void ball(sf::RenderWindow& w, float x, float y, float rad, sf::Color c) {
    sf::CircleShape s(rad);
    s.setOrigin({rad, rad});
    s.setPosition({x, y});
    s.setFillColor(c);
    w.draw(s, sf::RenderStates(gXf));
}

inline void poly(sf::RenderWindow& w, int n, const float* p, sf::Color c) {
    sf::ConvexShape s(n);
    for (int i = 0; i < n; i++) s.setPoint(i, {p[2 * i], p[2 * i + 1]});
    s.setFillColor(c);
    w.draw(s, sf::RenderStates(gXf));
}

inline sf::Color mix(sf::Color a, sf::Color b, float t) {
    return sf::Color((unsigned char)(a.r + (b.r - a.r) * t),
                     (unsigned char)(a.g + (b.g - a.g) * t),
                     (unsigned char)(a.b + (b.b - a.b) * t));
}

