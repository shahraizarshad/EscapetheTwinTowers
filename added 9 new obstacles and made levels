// ===================== asset finding (font + music) =====================
// Looks for a file in the places where it is most likely to be, and returns its full path ("" if not found):
//   1) the folder you ran the game from   2) an "assets" folder there
//   3) the folder of the program itself (e.g. output/)   4) the folder above it (e.g. arrayprograms/)   + their "assets"
// Because we check that the file exists BEFORE asking SFML to open it, SFML prints no error messages.
std::string findAsset(const std::string& name) {
    std::error_code ec;
    std::vector<fs::path> dirs;
    fs::path cwd = fs::current_path(ec);
    if (!ec) { dirs.push_back(cwd);  dirs.push_back(cwd / "assets"); }
    fs::path exe = fs::read_symlink("/proc/self/exe", ec);            // Linux / WSL: where the program lives
    if (!ec) {
        fs::path d = exe.parent_path();
        dirs.push_back(d);                  dirs.push_back(d / "assets");
        dirs.push_back(d.parent_path());    dirs.push_back(d.parent_path() / "assets");
    }
    for (const fs::path& d : dirs) {
        fs::path p = d / name;
        if (fs::is_regular_file(p, ec)) return p.string();
    }
    return "";
}
// Loads font.ttf if we have one, otherwise the first system font that exists. Returns false only if nothing works.
bool loadFont(sf::Font& font) {
    std::string mine = findAsset("font.ttf");
    if (!mine.empty() && font.openFromFile(mine)) return true;
    const char* fontPaths[] = {
        "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",           // Ubuntu / WSL (package fonts-dejavu-core)
        "/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf",
        "/usr/share/fonts/truetype/freefont/FreeSansBold.ttf",
        "/usr/share/fonts/truetype/ubuntu/Ubuntu-B.ttf",
        "/mnt/c/Windows/Fonts/arialbd.ttf",                              
        "/mnt/c/Windows/Fonts/arial.ttf",
        "/mnt/c/Windows/Fonts/segoeui.ttf"
    };
    std::error_code ec;
    for (const char* p : fontPaths)
        if (fs::is_regular_file(p, ec) && font.openFromFile(p)) return true;
    return false;
}
// Returns the path of the first music file found ("" if there is none)
std::string findMusic() {
    const char* names[] = {"music.ogg", "music.wav", "music.mp3", "music.flac"};
    for (const char* n : names) {
        std::string p = findAsset(n);
        if (!p.empty()) return p;
    }
    return "";
}

