bool touches(const sf::FloatRect& a, const sf::FloatRect& b) { return a.findIntersection(b).has_value(); }


// OBSTACLES START   (everything about obstacles lives between this line and "OBSTACLES END")

// Nine kinds of obstacle share ONE struct and ONE vector, so adding a new kind later is easy.
//
//  OBSTACLE ENTRY MAP: where each obstacle ENTERS the screen -
//  tier = score / 200  (tier 0 = first 200 points, tier 1 = 200..399, ...). The spawn code is in updateObstacles(),
//  each entry point is marked with  ">>> ENTERS HERE".  The "level >= n" test in that code is the tier it unlocks at.
//
//   kind     name                  ENTERS from ...                                          tier
//   O_TOWER  ground tower          RIGHT edge, standing on the ground                        0+
//   O_CLOUD  black storm cloud     TOP edge (above the screen), falls while drifting left   0+
//   O_WIND   wind zone             RIGHT edge, a box of air that pushes the plane up/down      0+
//   O_BIRD   single bird           RIGHT edge, flies faster than the world                     1+
//   O_GATE   sliding-gap tower     RIGHT edge, top + bottom block, the gap slides up/down       1+
//   O_BIRD   bird FLOCK (V shape)  RIGHT edge, 3-5 birds one behind the other               2+
//   O_BOLT   lightning strike      TOP edge (yellow warning line first), fixed on screen     2+
//   O_CRANE  swinging crane        TOP edge, hangs from the sky, a crate swings like a         3+
//                                  pendulum (only the crate hurts, the rope does not)
//   O_DRONE  bobbing drone         RIGHT edge, flies fast and moves up/down in a wave     
// -------------------------------------------------------------------------------------------
enum ObType { O_TOWER, O_CLOUD, O_BIRD, O_BOLT, O_WIND, O_GATE, O_CRANE, O_DRONE };
struct Obstacle {
    ObType type;
    float x, y, w, h;      // top-left corner and size of the obstacle's box
    float vx, vy;          // EXTRA speed on top of the world scrolling (pixels per second)
    float timer;           // seconds since it was created (used for animation and movement)
    float dir;             // wind only: +1 pushes down, -1 pushes up
    float a;               // spare number:  drone = base height,  gate = centre of the gap,  crane = swing phase
    bool scrolls;          // true = moves left with the world, false = stays at the same x on screen
    bool passed;           // already counted for the score? (makes scoring happen once)
};
std::vector<Obstacle> obs;                                         // every obstacle currently alive
float tTower, tCloud, tBird, tWind, tBolt, tGate, tCrane, tDrone;  // countdowns (seconds) until the next spawn of each kind
float quietTime, sinceTower;                                       // quietTime: pause after a special obstacle; sinceTower: seconds since the last ground tower

void addObstacle(ObType t, float x, float y, float w, float h, float vx, float vy, bool scrolls, float dir = 0, float a = 0) {
    obs.push_back({t, x, y, w, h, vx, vy, 0.f, dir, a, scrolls, false});
}
void resetObstacles() {                                            // called at the start of every run
    obs.clear();
    tTower = 0.8f;  tCloud = 3.f;  tBird = 6.f;  tWind = 5.f;  tBolt = 8.f;  tGate = 5.f;  tCrane = 9.f;  tDrone = 7.f;
    quietTime = 0;  sinceTower = 5;
}
void calmTowers(float t) { if (tTower < t) tTower = t; }          // keep ground towers away for t seconds after a special obstacle

// Position of the swinging crate. o.h = rope length, o.a = swing phase. Returns the rope angle (0 = straight down).
float cranePos(const Obstacle& o, float& cx, float& cy) {
    float ang = 0.8f * std::sin(o.timer * 1.8f + o.a);
    cx = o.x + o.w / 2 + o.h * std::sin(ang);
    cy = o.h * std::cos(ang);
    return ang;
}

// Called once per frame while playing.  dt = frame time, scroll = world speed, level = difficulty tier
void updateObstacles(float dt, float scroll, int level) {
    float k = std::max(0.5f, 1.f - 0.07f * level);                 // waits between spawns shrink as the tier rises

    // ---- 1) SPAWNING: count down each timer; at zero create the obstacle and restart the timer ----
    tTower -= dt;  tCloud -= dt;  tBird -= dt;  tWind -= dt;  tBolt -= dt;
    tGate -= dt;  tCrane -= dt;  tDrone -= dt;  quietTime -= dt;  sinceTower += dt;

    if (tTower <= 0) {
        // >>> ENTERS HERE (O_TOWER): ground tower appears at the RIGHT edge (x = 1050) standing on the ground
        float h = rnd(130, 330);
        addObstacle(O_TOWER, 1050, GROUND_Y - h, TOWER_W, h, 0, 0, true);
        tTower = rnd(1.3f, 2.3f) * k;  sinceTower = 0;
    }
    if (tWind <= 0) {
        // >>> ENTERS HERE (O_WIND): wind zone appears at the RIGHT edge, random height, random direction (up or down)
        addObstacle(O_WIND, 1050, rnd(60, 330), 260, 170, 0, 0, true, rnd(0, 1) < 0.5f ? -1.f : 1.f);
        tWind = rnd(7, 11);
    }
    if (quietTime <= 0) {                                          // only ONE special obstacle spawns at a time
        // (the rare kinds are checked first so the common ones can never "starve" them)
        if (level >= 3 && tCrane <= 0 && sinceTower > 1.4f) {
            // >>> ENTERS HERE (O_CRANE, tier 3+): crane hangs from the TOP edge; o.h = rope length, a = random swing phase
            float len = rnd(180, 330);
            addObstacle(O_CRANE, 1050 - len, 0, 2 * len + 70, len, 0, 0, true, 0, rnd(0, 6.28f));
            tCrane = rnd(9, 14) * k;  quietTime = 1.2f;  calmTowers(2.5f);
        } else if (level >= 1 && tGate <= 0 && sinceTower > 1.4f) {
            // >>> ENTERS HERE (O_GATE, tier 1+): sliding-gap tower appears at the RIGHT edge; a = middle of the gap
            float gapH = std::max(150.f, 205.f - level * 6);
            addObstacle(O_GATE, 1050, 0, TOWER_W, gapH, 0, 0, true, 0, rnd(210, 340));
            tGate = rnd(7, 11) * k;  quietTime = 1.0f;  calmTowers(2.0f);
        } else if (level >= 2 && tBolt <= 0) {
            // >>> ENTERS HERE (O_BOLT, tier 2+): lightning starts at the TOP; it does not scroll: warning line, then strike
            addObstacle(O_BOLT, rnd(380, 900), 80, 60, GROUND_Y - 80, 0, 0, false);
            tBolt = rnd(5, 8) * k;  quietTime = 1.2f;
        } else if (level >= 3 && tDrone <= 0) {
            // >>> ENTERS HERE (O_DRONE, tier 3+): drone appears at the RIGHT edge; a = the height it bobs around
            addObstacle(O_DRONE, 1050, 0, 46, 22, -150, 0, true, 0, rnd(150, 420));
            tDrone = rnd(5, 8) * k;  quietTime = 1.0f;  calmTowers(1.2f);
        } else if (level >= 1 && tBird <= 0) {
            float y0 = rnd(150, 420);
            if (level >= 2 && rnd(0, 1) < 0.5f) {
                // >>> ENTERS HERE (O_BIRD FLOCK, tier 2+): 3-5 birds appear at the RIGHT edge, one behind the other (V shape)
                int n = 3 + rand() % 3;
                for (int i = 0; i < n; i++) {
                    float off = ((i + 1) / 2) * 30.f * (i % 2 ? 1.f : -1.f);      // 0, +30, -30, +60, -60
                    addObstacle(O_BIRD, 1050 + i * 50, y0 + off, 40, 20, -180, 0, true);
                    if (i > 0) obs.back().passed = true;                          // only the leader gives +10 points
                }
                calmTowers(1.8f);
            } else {
                // >>> ENTERS HERE (O_BIRD, tier 1+): one bird appears at the RIGHT edge, random height
                addObstacle(O_BIRD, 1050, rnd(80, 480), 40, 20, -180, 0, true);
            }
            tBird = rnd(4, 7) * k;  quietTime = 0.9f;
        } else if (tCloud <= 0) {
            // >>> ENTERS HERE , black storm cloud starts ABOVE the screen (y < 0) and falls down
            float s = rnd(1.0f, 1.5f);
            addObstacle(O_CLOUD, rnd(1050, 1250), -90 * s, 120 * s, 70 * s, 0, rnd(110, 190) + level * 10, true);
            tCloud = rnd(2.2f, 3.6f) * k;  quietTime = 0.9f;
        }
    }

    //  MOVING, SCORING and DELETING 
    for (std::size_t i = 0; i < obs.size();) {
        Obstacle& o = obs[i];
        o.timer += dt;
        o.x += ((o.scrolls ? -scroll : 0.f) + o.vx) * dt;
        o.y += o.vy * dt;
        if (o.type == O_DRONE) o.y = o.a + 80 * std::sin(o.timer * 2.6f);                  // hilne wali wavess
        if (o.type == O_GATE) o.y = o.a + 70 * std::sin(o.timer * 1.7f) - o.h / 2;         // gap slides up and down

        bool gone = o.x + o.w < -20                                // left the screen
                 || o.y > GROUND_Y                                 // a falling cloud reached the ground
                 || (o.type == O_BOLT && o.timer > 1.5f);          // lightning finished
        bool behind = o.type != O_BOLT && o.x + o.w < pX - 125;    // completely behind the plane's tail
        if ((behind || gone) && !o.passed && o.type != O_WIND) { o.passed = true; score += 10; }   // +10, once
        if (gone) obs.erase(obs.begin() + i); else i++;
    }
}

// The part of an obstacle that actually hurts. Slightly smaller than the drawing so crashes feel fair.
sf::FloatRect obstacleBox(const Obstacle& o) {
    float cx = 0, cy = 0;
    switch (o.type) {
        case O_CLOUD: return sf::FloatRect({o.x + 14, o.y + 18}, {o.w - 28, o.h - 28});
        case O_BIRD:  return sf::FloatRect({o.x + 4, o.y + 3}, {o.w - 8, o.h - 6});
        case O_DRONE: return sf::FloatRect({o.x + 4, o.y + 3}, {o.w - 8, o.h - 6});
        case O_BOLT:  return sf::FloatRect({o.x, o.y}, {o.w, o.h});
        case O_CRANE: cranePos(o, cx, cy); return sf::FloatRect({cx - 22, cy - 22}, {44, 44});   // only the crate hurts
        default:      return sf::FloatRect({o.x + 3, o.y}, {o.w - 6, o.h});
    }
}
// Does the rectangle r (a part of the plane) touch any deadly obstacle?
bool obstaclesHit(const sf::FloatRect& r) {
    for (const Obstacle& o : obs) {
        if (o.type == O_WIND) continue;                                         // wind never kills
        if (o.type == O_BOLT && !(o.timer > 1.2f && o.timer < 1.5f)) continue;  // lightning hurts only while striking
        if (o.type == O_GATE) {                                                 // two blocks with a moving gap between them
            sf::FloatRect top({o.x + 3, 0}, {o.w - 6, o.y});
            sf::FloatRect bottom({o.x + 3, o.y + o.h}, {o.w - 6, GROUND_Y - o.y - o.h});
            if (touches(r, top) || touches(r, bottom)) return true;
            continue;
        }
        if (touches(r, obstacleBox(o))) return true;
    }
    return false;
}
// Vertical push (pixels per second) from the wind zones that rectangle r is inside of
float windAt(const sf::FloatRect& r) {
    float push = 0;
    for (const Obstacle& o : obs)
        if (o.type == O_WIND && touches(r, sf::FloatRect({o.x, o.y}, {o.w, o.h}))) push += o.dir * 230;
    return push;
}

//  drawing the obstacles 
sf::Color windowColor(int r, int c) {                                 // more windows light up when it gets dark
    bool lit = (r + c) % 3 == 0 || (look.night > 0.5f && (r * 2 + c) % 2 == 0);
    return lit ? sf::Color(255, 235, 150) : mix(sf::Color(170, 215, 240), sf::Color(40, 55, 90), look.night);
}
void drawBlock(sf::RenderWindow& w, float x, float y, float h) {      // a steel tower blockment
    box(w, x, y, TOWER_W, h, sf::Color(112, 122, 138));
    box(w, x, y, 6, h, sf::Color(85, 95, 110));                           // darker left edge
    for (int r = 0; 14 + r * 40 + 24 < h; r++)                            // window 
        for (int c = 0; c < 3; c++) box(w, x + 14 + c * 26, y + 14 + r * 40, 16, 24, windowColor(r, c));
}
void drawGroundTower(sf::RenderWindow& w, float x, float y, float h) {
    drawBlock(w, x, y, h);
    box(w, x - 4, y - 8, TOWER_W + 8, 10, sf::Color(95, 105, 120));       // roof
    box(w, x + TOWER_W / 2 - 2, y - 30, 4, 22, sf::Color(70, 75, 85));    // antenna
}
void drawGate(sf::RenderWindow& w, const Obstacle& o) {
    drawBlock(w, o.x, 0, o.y);                                            // top block hangs from the sky
    drawBlock(w, o.x, o.y + o.h, GROUND_Y - o.y - o.h);                   // bottom block stands on the ground
    sf::Color warn(255, 200, 30);
    box(w, o.x - 4, o.y - 8, TOWER_W + 8, 8, warn);                       // yellow caps mark the moving gap
    box(w, o.x - 4, o.y + o.h, TOWER_W + 8, 8, warn);
}
void drawStormCloud(sf::RenderWindow& w, const Obstacle& o) {
    float s = o.w / 120.f;                                                // cloud sizeee
    sf::Color rim = mix(sf::Color(90, 90, 110), sf::Color(200, 205, 230), look.night);   // ye dark lighting ko accomodate krne keliye
    cloud(w, o.x - 3, o.y + o.h + 3, s * 1.05f, rim);
    cloud(w, o.x, o.y + o.h, s, mix(sf::Color(38, 38, 50), sf::Color(105, 110, 150), look.night));                    // dark body
    cloud(w, o.x + 0.12f * o.w, o.y + o.h - 4, s * 0.75f, mix(sf::Color(58, 58, 74), sf::Color(130, 135, 170), look.night));   // lighter middle
}
void drawBird(sf::RenderWindow& w, const Obstacle& o) {
    float cx = o.x + o.w / 2, cy = o.y + o.h / 2;
    float flap = std::sin(o.timer * 16) * 14;                             // wing goes up and down
    float wing[] = {cx - 8, cy, cx + 8, cy, cx + 2, cy - flap};
    float tail[] = {cx + 6, cy - 2, cx + 20, cy + 2, cx + 6, cy + 4};
    float beak[] = {cx - 14, cy - 5, cx - 22, cy - 2, cx - 14, cy};
    sf::Color dark = mix(sf::Color(25, 25, 30), sf::Color(215, 220, 235), look.night);   // adjustment of bird lightening 
    poly(w, 3, wing, dark);
    poly(w, 3, tail, dark);
    ball(w, cx, cy, 8, dark);                                             // body
    ball(w, cx - 10, cy - 3, 5, dark);                                    // head
    poly(w, 3, beak, sf::Color(240, 160, 30));
}
void drawBolt(sf::RenderWindow& w, const Obstacle& o) {
    float cx = o.x + o.w / 2;
    cloud(w, cx - 90, 100, 1.5f, mix(sf::Color(40, 40, 52), sf::Color(105, 110, 150), look.night));   // the storm cloud it comes from
    if (o.timer < 1.2f) {                                                 // WARNING: flashing dashed yellow line
        int a = (int)(90 + 120 * (0.5f + 0.5f * std::sin(o.timer * 18)));
        for (float yy = 105; yy < GROUND_Y; yy += 34) box(w, cx - 3, yy, 6, 18, sf::Color(255, 230, 60, a));
    } else {                                                              // STRIKE: zigzag bolt from cloud to ground
        float x0 = cx, y0 = 100;
        for (int k = 1; y0 < GROUND_Y; k++) {
            float x1 = cx + ((k % 2) ? 18.f : -18.f), y1 = std::min(y0 + 55.f, GROUND_Y);
            float outer[] = {x0 - 9, y0, x0 + 9, y0, x1 + 9, y1, x1 - 9, y1};
            float inner[] = {x0 - 3, y0, x0 + 3, y0, x1 + 3, y1, x1 - 3, y1};
            poly(w, 4, outer, sf::Color(255, 230, 60, 200));
            poly(w, 4, inner, sf::Color::White);
            x0 = x1;  y0 = y1;
        }
        box(w, 0, 0, 1000, 600, sf::Color(255, 255, 255, 60));            // whole screen flashes
    }
}
void drawCrane(sf::RenderWindow& w, const Obstacle& o) {
    float cx = 0, cy = 0;
    float ang = cranePos(o, cx, cy);
    float ax = o.x + o.w / 2;                                             // where the rope is fixed (top of the screen)
    sf::RectangleShape rope({3.f, o.h});                                  // the rope is a thin rectangle that swings
    rope.setOrigin({1.5f, 0.f});
    rope.setPosition({ax, 0.f});
    rope.setRotation(sf::radians(-ang));
    rope.setFillColor(mix(sf::Color(60, 60, 70), sf::Color(210, 215, 230), look.night));
    w.draw(rope);
    box(w, ax - 16, 0, 32, 10, sf::Color(90, 95, 110));                   
    sf::Color wood(150, 80, 20);
    box(w, cx - 28, cy - 28, 56, 56, sf::Color(220, 130, 40));            // cargo crate (this is the deadly part)
    box(w, cx - 28, cy - 28, 56, 7, wood);
    box(w, cx - 28, cy + 21, 56, 7, wood);
    box(w, cx - 3, cy - 28, 6, 56, wood);
}
void drawDrone(sf::RenderWindow& w, const Obstacle& o) {
    float cx = o.x + o.w / 2;
    sf::Color dark = mix(sf::Color(45, 50, 60), sf::Color(200, 205, 225), look.night);
    box(w, o.x, o.y + 8, o.w, 14, dark);                                  // body
    box(w, cx - 3, o.y + 2, 6, 8, dark);                                  // mast
    float span = ((int)(o.timer * 30) % 2) ? 50.f : 36.f;                 // rotor blur flickers between two widths
    box(w, cx - span / 2, o.y, span, 3, dark);
    ball(w, cx, o.y + 15, 3.5f, ((int)(o.timer * 5) % 2) ? sf::Color(255, 40, 40) : sf::Color(120, 20, 20));   // blinking light
}
void drawWind(sf::RenderWindow& w, const Obstacle& o) {
    box(w, o.x, o.y, o.w, o.h, sf::Color(255, 255, 255, 38));             // faint white zone
    box(w, o.x, o.y, o.w, 3, sf::Color(255, 255, 255, 120));              // top edge
    box(w, o.x, o.y + o.h - 3, o.w, 3, sf::Color(255, 255, 255, 120));    // bottom edge
    for (int k = 0; k < 5; k++) {                                         // streaks travel in the wind's direction
        float sxk = o.x + 30 + k * 48;
        float off = std::fmod(o.timer * 140 + k * 37, o.h - 28);
        float syk = (o.dir > 0) ? o.y + 14 + off : o.y + o.h - 14 - off;
        box(w, sxk, syk - 14, 4, 28, sf::Color(255, 255, 255, 190));
    }
}
void drawObstacles(sf::RenderWindow& w) {
    for (const Obstacle& o : obs) if (o.type == O_WIND) drawWind(w, o);   // wind first  so it is behind everything
    for (const Obstacle& o : obs) {
        if (o.type == O_TOWER) drawGroundTower(w, o.x, o.y, o.h);
        else if (o.type == O_GATE) drawGate(w, o);
        else if (o.type == O_CLOUD) drawStormCloud(w, o);
        else if (o.type == O_BIRD) drawBird(w, o);
        else if (o.type == O_DRONE) drawDrone(w, o);
        else if (o.type == O_CRANE) drawCrane(w, o);
        else if (o.type == O_BOLT) drawBolt(w, o);
    }
}
