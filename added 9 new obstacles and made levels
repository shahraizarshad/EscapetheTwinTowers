// THE CHANGING SKY: the five "looks" below (DAY, SUNSET, STORM, NIGHT, DAWN) are blended smoothly.
// Every 200 points the difficulty tier goes up by one and the sky moves on to the next look.
struct Look {
    sf::Color top, bottom, farC, nearC, cloud, ground, body;   // sky top/bottom, far/near city, clouds, ground, sun or moon
    float bodyY, bodyA;                                        // height of the sun/moon, and how visible it is (0-255)
    float night;                                               // 0 = bright, 1 = dark (windows light up, obstacles get lighter)
    float rain, stars;                                         // 0 = none, 1 = full
};
const Look PAL[5] = {
    // top                  bottom                 far city               near city              clouds                 ground                 sun/moon               y    a   night  rain stars
    {sf::Color(95,175,230), sf::Color(200,235,250), sf::Color(165,195,220), sf::Color(135,165,195), sf::Color(255,255,255), sf::Color(90,170,90),  sf::Color(255,245,190), 90,  255, 0.0f,  0,   0},   // DAY
    {sf::Color(105,90,165), sf::Color(255,170,100), sf::Color(165,110,140), sf::Color(125,85,120),  sf::Color(255,205,170), sf::Color(115,150,75), sf::Color(255,160,80),  330, 255, 0.3f,  0,   0},   // SUNSET
    {sf::Color(65,75,95),   sf::Color(135,145,160), sf::Color(105,115,130), sf::Color(85,95,110),   sf::Color(120,125,140), sf::Color(65,105,75),  sf::Color(170,180,190), 200, 0,   0.45f, 1,   0},   // STORM
    {sf::Color(8,12,40),    sf::Color(38,52,100),   sf::Color(32,42,78),    sf::Color(22,30,60),    sf::Color(80,90,130),   sf::Color(30,70,60),   sf::Color(235,240,255), 90,  255, 1.0f,  0,   1},   // NIGHT
    {sf::Color(115,135,210),sf::Color(255,205,175), sf::Color(185,165,200), sf::Color(160,140,178), sf::Color(255,225,215), sf::Color(100,160,95), sf::Color(255,205,150), 340, 255, 0.3f,  0,   0}    // DAWN
};
Look look = PAL[0];                              // the look being drawn right now (a blend of two entries of PAL)
float phaseF = 0, phaseTarget = 0;               // phaseF slowly follows phaseTarget (= the difficulty tier)

struct Skyline { float x[30], w[30], h[30]; float total, offset, speed; sf::Color col; };
Skyline farCity, nearCity;                       // two rows of buildings that scroll at different speeds (parallax)
const int NC = 10;                               // 10 clouds: 0..4 are far/small/slow, 5..9 are near/big/faster
float cloudX[NC], cloudY[NC], cloudS[NC], cloudV[NC];
const int NS = 14;                               // 14 white speed streaks that fly past
float stX[NS], stY[NS], stL[NS];
const int NR = 70, NSTAR = 50;                   // 70 rain drops, 50 stars
float rainX[NR], rainY[NR], starX[NSTAR], starY[NSTAR];
float groundOff = 0, bgTime = 0;                 // how far the ground pattern has scrolled, seconds since start

void buildSkyline(Skyline& s, float minH, float maxH, float speed, sf::Color col) {
    s.total = 0;  s.offset = 0;  s.speed = speed;  s.col = col;
    for (int i = 0; i < 30; i++) {               // random buildings placed side by side
        s.w[i] = rnd(40, 90);
        s.h[i] = rnd(minH, maxH);
        s.x[i] = s.total;
        s.total += s.w[i];
    }
}
void initBackground() {                          // call once, after srand()
    buildSkyline(farCity, 90, 210, 14, sf::Color(165, 195, 220));
    buildSkyline(nearCity, 40, 130, 30, sf::Color(135, 165, 195));
    for (int i = 0; i < NC; i++) {
        bool isFar = i < 5;
        cloudX[i] = rnd(0, 1000);
        cloudY[i] = isFar ? rnd(40, 300) : rnd(60, 470);
        cloudS[i] = isFar ? rnd(0.5f, 0.8f) : rnd(0.9f, 1.4f);
        cloudV[i] = isFar ? rnd(5, 10) : rnd(14, 26);
    }
    for (int i = 0; i < NS; i++) { stX[i] = rnd(0, 1000); stY[i] = rnd(30, 520); stL[i] = rnd(30, 90); }
    for (int i = 0; i < NR; i++) { rainX[i] = rnd(0, 1100); rainY[i] = rnd(0, 600); }
    for (int i = 0; i < NSTAR; i++) { starX[i] = rnd(0, 1000); starY[i] = rnd(10, 330); }
    look = PAL[0];
}
// mult = how fast the world moves: 1 = normal, 0 = frozen (pause), 0.5 = calm (menu)
void updateBackground(float dt, float mult) {
    bgTime += dt;
    //  the sky follows the difficulty tier: blend PAL[i] -> PAL[i + 1] 
    phaseF += (phaseTarget - phaseF) * std::min(1.f, dt * 1.2f);   // slow, smooth change (takes about 2 seconds)
    int i = (int)phaseF % 5, j = (i + 1) % 5;                      // current look and the next one
    float t = phaseF - (int)phaseF;                                // 0 = fully PAL[i], 1 = fully PAL[j]
    look.top = mix(PAL[i].top, PAL[j].top, t);        look.bottom = mix(PAL[i].bottom, PAL[j].bottom, t);
    look.farC = mix(PAL[i].farC, PAL[j].farC, t);     look.nearC = mix(PAL[i].nearC, PAL[j].nearC, t);
    look.cloud = mix(PAL[i].cloud, PAL[j].cloud, t);  look.ground = mix(PAL[i].ground, PAL[j].ground, t);
    look.body = mix(PAL[i].body, PAL[j].body, t);
    look.bodyY = fl(PAL[i].bodyY, PAL[j].bodyY, t);   look.bodyA = fl(PAL[i].bodyA, PAL[j].bodyA, t);
    look.night = fl(PAL[i].night, PAL[j].night, t);
    look.rain = fl(PAL[i].rain, PAL[j].rain, t);      look.stars = fl(PAL[i].stars, PAL[j].stars, t);

    farCity.offset = std::fmod(farCity.offset + farCity.speed * mult * dt, farCity.total);
    nearCity.offset = std::fmod(nearCity.offset + nearCity.speed * mult * dt, nearCity.total);
    groundOff = std::fmod(groundOff + 250 * mult * dt, 1400.f);
    for (int k = 0; k < NC; k++) {
        cloudX[k] -= cloudV[k] * mult * dt;
        if (cloudX[k] < -150 * cloudS[k]) {      // left the screen -> come back on the right at a new height
            cloudX[k] = 1050 + rnd(0, 200);
            cloudY[k] = k < 5 ? rnd(40, 300) : rnd(60, 470);
        }
    }
    for (int k = 0; k < NS; k++) {
        stX[k] -= 500 * mult * dt;
        if (stX[k] + stL[k] < 0) { stX[k] = 1000 + rnd(0, 300); stY[k] = rnd(30, 520); }
    }
    for (int k = 0; k < NR; k++) {               // rain falls down and a little to the left
        rainY[k] += 650 * mult * dt;
        rainX[k] -= 100 * mult * dt;
        if (rainY[k] > 600) { rainY[k] = -20; rainX[k] = rnd(0, 1100); }
    }
}
void drawSkyline(sf::RenderWindow& w, const Skyline& s) {
    for (int pass = 0; pass < 2; pass++)         // drawn twice, side by side, so it wraps around seamlessly
        for (int i = 0; i < 30; i++) {
            float bx = s.x[i] + pass * s.total - s.offset;
            if (bx > 1000 || bx + s.w[i] < 0) continue;      // off screen: skip
            box(w, bx, GROUND_Y - s.h[i], s.w[i] + 1, s.h[i], s.col);
        }
}
void drawGround(sf::RenderWindow& w) {
    sf::Color g = look.ground;
    box(w, 0, GROUND_Y, 1000, 50, g);
    box(w, 0, GROUND_Y, 1000, 6, mix(g, sf::Color::White, 0.2f));      // lighter grass edge
    for (int i = 0; i < 20; i++) {                                     // stripes and bushes scroll left
        float x = std::fmod(i * 70.f - groundOff, 1400.f);
        if (x < 0) x += 1400.f;
        x -= 70;
        box(w, x, GROUND_Y + 6, 34, 44, mix(g, sf::Color(0, 0, 0), 0.12f));
        if (i % 3 == 0) ball(w, x + 20, GROUND_Y, 15, mix(g, sf::Color(0, 0, 0), 0.28f));
    }
}
void drawBackground(sf::RenderWindow& w, bool streaksOn) {
    for (int i = 0; i < 12; i++) box(w, 0, i * 50.f, 1000, 51, mix(look.top, look.bottom, i / 11.f));   // sky gradient
    if (look.stars > 0.02f)                                            // twinkling stars (night)
        for (int i = 0; i < NSTAR; i++) {
            float a = look.stars * (150 + 100 * std::sin(bgTime * 3 + i));
            box(w, starX[i], starY[i], 2, 2, sf::Color(255, 255, 255, (int)a));
        }
    if (look.bodyA > 1) {                                              // sun (day, sunset, dawn) or moon (night)
        sf::Color glow = look.body, core = mix(look.body, sf::Color::White, 0.5f), mid = look.body;
        glow.a = (int)(60 * look.bodyA / 255);  mid.a = (int)look.bodyA;  core.a = (int)look.bodyA;
        ball(w, 880, look.bodyY, 78, glow);
        ball(w, 880, look.bodyY, 52, mid);
        ball(w, 880, look.bodyY, 38, core);
    }
    sf::Color farCloud(look.cloud.r, look.cloud.g, look.cloud.b, 200);
    for (int i = 0; i < 5; i++) cloud(w, cloudX[i], cloudY[i], cloudS[i], farCloud);
    farCity.col = look.farC;  nearCity.col = look.nearC;
    drawSkyline(w, farCity);
    drawSkyline(w, nearCity);
    for (int i = 5; i < NC; i++) cloud(w, cloudX[i], cloudY[i], cloudS[i], look.cloud);
    drawGround(w);
    if (look.rain > 0.05f)                                             // rain (storm)
        for (int i = 0; i < NR; i++) box(w, rainX[i], rainY[i], 2, 18, sf::Color(220, 230, 255, (int)(look.rain * 130)));
    if (streaksOn)
        for (int i = 0; i < NS; i++) box(w, stX[i], stY[i], stL[i], 2, sf::Color(255, 255, 255, 90));
}
