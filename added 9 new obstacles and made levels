// best.txt is saved next to the program's working folder (same as before)
int loadBest() { std::ifstream f("best.txt"); int b = 0; f >> b; return b; }
void saveBest() { std::ofstream f("best.txt"); f << best; }

void startGame() {                                                    // fresh run: call on Play / Retry / Restart
    score = 0;  scrollSpeed = 250;  hitFlash = 0;
    pX = 300;  pY = 280;
    lastLevel = 0;  bannerTime = 3;                                   // shows "TIER 1 - DAY" at the start
    phaseF = 0;  phaseTarget = 0;                                     // sky starts as DAY
    resetObstacles();
}

int main() {
    srand((unsigned)time(0));
    initBackground();
    sf::RenderWindow window(sf::VideoMode({1000u, 600u}), "Escape The Twin Towers");
    window.setFramerateLimit(60);

    //  font: font.ttf if present, otherwise a system font (no error messages either way) ----
    sf::Font font;
    if (!loadFont(font)) {
        std::cout << "No font found!  Fix: copy any .ttf file next to f.cpp and name it font.ttf,\n"
                     "or run:  sudo apt install fonts-dejavu-core\n";
        return 1;
    }

    //  music is optional:
    // The Music object is only created when a music file really exists, so a missing file prints nothing at all.
    std::unique_ptr<sf::Music> music;
    std::string musicPath = findMusic();
    if (!musicPath.empty()) {
        music = std::make_unique<sf::Music>();
        if (music->openFromFile(musicPath)) { music->setLooping(true); music->setVolume(40); }
        else music.reset();                                           // file exists but is unreadable , play without music
    }
    bool muted = false;
    best = loadBest();

    State state = NOTICE;
    float noseX = -20, boomTime = 0, menuTime = 0, smokeTimer = 0;
    bool crashed = false;
    sf::Clock clock;
    using K = sf::Keyboard::Key;

    auto begin = [&]() {                                              // start a run
        startGame();
        state = PLAYING;
        if (music) music->play();
    };

    while (window.isOpen()) {
        float dt = clock.restart().asSeconds();
        if (dt > 0.05f) dt = 0.05f;
        sf::Vector2f mouse = window.mapPixelToCoords(sf::Mouse::getPosition(window));
        bool hover = mouse.x > 370 && mouse.x < 630 && mouse.y > 295 && mouse.y < 365;   // PLAY button area

        //  input
        while (const std::optional event = window.pollEvent()) {
            if (event->is<sf::Event::Closed>()) window.close();
            if (const auto* key = event->getIf<sf::Event::KeyPressed>()) {
                K k = key->code;
                if (state == NOTICE && k == K::Enter) state = INTRO;
                else if (state == INTRO && k == K::Enter) { state = MENU; menuTime = 2; }          // skip intro
                else if (state == MENU && k == K::Enter && menuTime > 1.3f) begin();
                else if (state == PLAYING && k == K::Escape) state = PAUSED;
                else if (state == PAUSED) {
                    if (k == K::Escape) state = PLAYING;
                    else if (k == K::R) begin();
                    else if (k == K::Backspace) { state = MENU; menuTime = 2; }
                }
                else if (state == GAMEOVER) {
                    if (k == K::R) begin();
                    else if (k == K::Escape) { state = MENU; menuTime = 2; }
                }
                if (k == K::M) { muted = !muted; if (music) music->setVolume(muted ? 0.f : 40.f); }
            }
            if (event->getIf<sf::Event::MouseButtonPressed>())
                if (state == MENU && menuTime > 1.3f && hover) begin();
        }

        // update 
        // the background moves with the world: normal speed while playing, frozen when paused, calm in menus
        float bg = 0.5f;
        if (state == PLAYING) bg = scrollSpeed / 250.f;
        else if (state == PAUSED) bg = 0;
        else if (state == GAMEOVER) bg = 0.15f;
        // the sky follows the difficulty tier (menus always show DAY)
        if (state == NOTICE || state == INTRO || state == MENU) { phaseF = 0; phaseTarget = 0; }
        else if (state == PLAYING) phaseTarget = score / 200;
        updateBackground(dt, bg);

        if (state == INTRO) {
            for (int i = 0; i < 40; i++)                              // smoke puffs fade out
                if (slife[i] > 0) { slife[i] -= 0.8f * dt; sy[i] -= 12 * dt; }
            for (int i = 0; i < N; i++)                               // explosion: gravity + movement
                if (life[i] > 0) { vy[i] += 300 * dt; px[i] += vx[i] * dt; py[i] += vy[i] * dt; life[i] -= dt; }
            if (!crashed) {
                noseX += 300 * dt;                                    // plane flies left to right
                smokeTimer += dt;
                if (smokeTimer > 0.03f) {
                    smokeTimer = 0;
                    for (int i = 0; i < 40; i++)
                        if (slife[i] <= 0) { sx[i] = noseX - 100; sy[i] = PLANE_Y + 30; slife[i] = 1; break; }
                }
                if (noseX >= TOWER_X) {
                    noseX = TOWER_X;
                    crashed = true;
                    for (int i = 0; i < N; i++) {
                        float angle = rnd(0, 6.2832f), speed = rnd(60, 400);
                        px[i] = TOWER_X;  py[i] = PLANE_Y;
                        vx[i] = std::cos(angle) * speed;  vy[i] = std::sin(angle) * speed;
                        life[i] = rnd(0.8f, 1.7f);
                    }
                }
            } else {
                boomTime += dt;
                if (boomTime >= 1.8f) { state = MENU; menuTime = 0; } // intro over -> title comes
            }
        } else if (state != NOTICE) menuTime += dt;

        if (state == PLAYING) {
            // difficulty tier: every 200 points = faster world + new obstacles + the next sky look
            int level = score / 200;
            if (level != lastLevel) { lastLevel = level; bannerTime = 3; }       // new tier -> show the banner
            bannerTime = std::max(0.f, bannerTime - dt);
            scrollSpeed = std::min(250.f + level * 20, 480.f);

            // player movement (WASD or arrows)
            float dx = 0, dy = 0;
            if (sf::Keyboard::isKeyPressed(K::W) || sf::Keyboard::isKeyPressed(K::Up))    dy -= 1;
            if (sf::Keyboard::isKeyPressed(K::S) || sf::Keyboard::isKeyPressed(K::Down))  dy += 1;
            if (sf::Keyboard::isKeyPressed(K::A) || sf::Keyboard::isKeyPressed(K::Left))  dx -= 1;
            if (sf::Keyboard::isKeyPressed(K::D) || sf::Keyboard::isKeyPressed(K::Right)) dx += 1;
            pX += dx * 320 * dt;
            pY += dy * 320 * dt;
            pY += windAt(sf::FloatRect({pX - 125, pY - 12}, {120, 24})) * dt;   // wind zones push the plane
            pX = std::clamp(pX, 150.f, 990.f);                                   // keep the plane on the screen
            pY = std::clamp(pY, 50.f, 505.f);

            updateObstacles(dt, scrollSpeed, level);                             //  obstacle code (spawn/move/score)

            // collision: the plane has two hitboxes (body and wing), smaller than the drawing so it feels fair
            sf::FloatRect body({pX - 125, pY - 12}, {120, 24});
            sf::FloatRect wing({pX - 100, pY + 10}, {40, 32});
            if (obstaclesHit(body) || obstaclesHit(wing)) {
                state = GAMEOVER;
                hitFlash = 1;
                if (score > best) { best = score; saveBest(); }
            }
        }
        if (state == GAMEOVER) hitFlash = std::max(0.f, hitFlash - 1.5f * dt);

        //  draw 
        drawBackground(window, state == PLAYING || state == PAUSED || state == GAMEOVER);
        if (state == NOTICE || state == INTRO || state == MENU) tower(window);

        sf::Color navy(25, 20, 110);
        if (state == NOTICE) {
            box(window, 100, 150, 800, 300, sf::Color(255, 255, 255, 225));
            center(window, font, "CONTENT NOTICE", 40, 500, 200, navy);
            center(window, font, "This game is inspired by the events of September 11, 2001.", 22, 500, 270, navy);
            center(window, font, "It is a fictionalized obstacle-avoidance game and shows no casualties.", 22, 500, 305, navy);
            center(window, font, "Press ENTER to continue", 26, 500, 390, sf::Color(200, 40, 40));
        } else if (state == INTRO) {
            for (int i = 0; i < 40; i++)
                if (slife[i] > 0) ball(window, sx[i], sy[i], 5 + (1 - slife[i]) * 14, sf::Color(255, 255, 255, (int)(slife[i] * 200)));
            if (!crashed || boomTime < 0.15f) plane(window, noseX, PLANE_Y);   // plane is destroyed by the blast
            if (crashed && boomTime < 0.12f) ball(window, TOWER_X, PLANE_Y, 120, sf::Color(255, 255, 200, 220));   // flash
            for (int i = 0; i < N; i++) {
                if (life[i] <= 0) continue;
                float a = life[i] > 1 ? 1 : life[i];                  // fades in the last second
                sf::Color c = (i % 3 == 0) ? sf::Color(255, 100, 0) : (i % 3 == 1) ? sf::Color(255, 210, 0) : sf::Color(55, 55, 60);
                c.a = (int)(a * 255);
                ball(window, px[i], py[i], (i % 3 == 2 ? 14 : 8) * (0.4f + 0.6f * a), c);
            }
            if (crashed && boomTime < 1.2f) {                         // BOOM sign
                float k = boomTime < 0.15f ? boomTime / 0.15f : 1 + 0.05f * std::sin(boomTime * 30);
                sf::Text t(font, "BOOM!", 100);
                t.setFillColor(sf::Color(255, 200, 0));
                t.setOutlineColor(sf::Color(200, 30, 0));
                t.setOutlineThickness(6);
                sf::FloatRect b = t.getLocalBounds();
                t.setOrigin({b.position.x + b.size.x / 2, b.position.y + b.size.y / 2});
                t.setPosition({500, 200});
                t.setScale({k, k});
                window.draw(t);
            }
            center(window, font, "Press ENTER to skip", 18, 500, 580, navy);
        } else if (state == MENU) {
            title(window, font, menuTime);
            if (menuTime > 1.3f) {                                    // PLAY button appears after the dance
                box(window, 367, 292, 266, 76, sf::Color(25, 25, 112));                                 // border
                box(window, 370, 295, 260, 70, hover ? sf::Color(255, 200, 40) : sf::Color(60, 70, 160));
                center(window, font, "PLAY", 36, 500, 330, hover ? sf::Color(25, 25, 112) : sf::Color::White);
                center(window, font, ("BEST SCORE: " + std::to_string(best)).c_str(), 24, 500, 410, navy);
                center(window, font, "WASD / Arrows: Move    Esc: Pause    R: Restart    M: Mute", 20, 500, 450, navy);
            }
        } else {                                                      // PLAYING, PAUSED, GAMEOVER
            drawObstacles(window);                                    // <-- obstacle code (drawing)
            plane(window, pX, pY);
            int tier = score / 200;
            label(window, font, "SCORE: " + std::to_string(score), 28, 20, 12, navy);
            label(window, font, "BEST: " + std::to_string(best), 22, 20, 48, navy);
            label(window, font, "TIER " + std::to_string(tier + 1) + " - " + STAGE[tier % 5], 22, 20, 78, navy);
            if (bannerTime > 0 && state != GAMEOVER) {                // "TIER n - NAME" banner when a new tier starts
                int a = (int)(255 * std::min(1.f, bannerTime));
                std::string s = "TIER " + std::to_string(tier + 1) + " - " + STAGE[tier % 5];
                box(window, 250, 140, 500, 70, sf::Color(0, 0, 0, (int)(a * 0.45f)));
                center(window, font, s.c_str(), 34, 500, 175, sf::Color(255, 255, 255, a));
            }
            if (hitFlash > 0) box(window, 0, 0, 1000, 600, sf::Color(255, 0, 0, (int)(hitFlash * 110)));
            if (state == PAUSED) {
                box(window, 0, 0, 1000, 600, sf::Color(255, 255, 255, 140));
                center(window, font, "PAUSED", 60, 500, 220, navy);
                center(window, font, "ESC: Resume    R: Restart    BACKSPACE: Main menu", 24, 500, 300, navy);
            }
            if (state == GAMEOVER) {
                box(window, 0, 0, 1000, 600, sf::Color(255, 255, 255, 140));
                center(window, font, "GAME OVER", 64, 500, 190, sf::Color(200, 40, 40));
                center(window, font, ("Score: " + std::to_string(score) + "     Best: " + std::to_string(best)).c_str(), 32, 500, 275, navy);
                center(window, font, "R: Retry    ESC: Main menu", 26, 500, 335, navy);
            }
        }
        window.display();
    }
    return 0;
}
