const float GUN_CD = 0.11f, MISSILE_CD = 1.4f;

struct Bullet { float x, y, vx, vy; int owner; bool missile; float life; };
std::vector<Bullet> bullets;

struct EnemyPlane { float x, y, vx, vy, hp, maxHp, shotCd; int kind; };
std::vector<EnemyPlane> enemies;
float tEnemy = 4.0f;

void drawEnemyPlane(sf::RenderWindow& w, float x, float y, int kind, float hpFrac) {
    float sc = (kind == 1) ? 1.15f : 0.92f;
    if (enemySpr && kind == 0) {
        enemySpr->setPosition({x, y});
        w.draw(*enemySpr);
    } else {
        sf::Color body   = (kind == 1) ? sf::Color(65, 35, 85)   : sf::Color(55, 60, 72);
        sf::Color accent = (kind == 1) ? sf::Color(255, 110, 30) : sf::Color(215, 40, 45);
        sf::Color glass  = (kind == 1) ? sf::Color(255, 200, 60) : sf::Color(255, 70, 70);
        auto sh = [&](std::initializer_list<float> pts, sf::Color c) {
            std::vector<float> p;
            int k = 0;
            for (float v : pts) p.push_back(v * sc + ((k++ % 2 == 0) ? x : y));
            poly(w, (int)(pts.size() / 2), p.data(), c);
        };
        float f = 0.8f + 0.3f * std::sin(bgTime * 45 + x);
        sh({52, -3, 52 + 22 * f, 0, 52, 3}, sf::Color(255, 90, 20, 220));
        sh({52, -1.5f, 52 + 12 * f, 0, 52, 1.5f}, sf::Color(255, 220, 100));
        sh({-55, 1, -35, -5, 45, -7, 52, -3, 52, 4, 35, 7, -35, 6}, body);
        sh({-55, 1, -35, -5, -28, -5, -28, 6, -35, 6}, accent);
        sh({-28, -5, -18, -13, -4, -14, 10, -7}, glass);
        sh({30, -6, 52, -34, 42, -34, 18, -6}, accent);
        sh({-5, 2, 20, 2, 34, 24, 18, 24}, mix(body, sf::Color::Black, 0.25f));
    }
    box(w, x - 24, y - 34 * sc, 48, 5, sf::Color(0, 0, 0, 180));
    box(w, x - 23, y - 33 * sc, 46 * hpFrac, 3, sf::Color(255, 65, 65));
}

void tryGun(int i) {
    if (i < 0 || i > 1) return;
    Player& p = pl[i];
    if (!p.alive || p.gunCd > 0) return;
    p.gunCd = GUN_CD;
    bullets.push_back({p.x + 6, p.y + 2, 950.f, p.vy * 0.12f, i, false, 1.5f});
    addPart(p.x + 8, p.y + 2, 220, rnd(-30, 30), 0.08f, 4, sf::Color(255, 240, 120));
    playSfx(SF_GUN);
}

void tryMissile(int i) {
    if (i < 0 || i > 1) return;
    Player& p = pl[i];
    if (!p.alive || p.misCd > 0) return;
    p.misCd = MISSILE_CD;
    bullets.push_back({p.x - 82, p.y + 34, 650.f, 0.f, i, true, 3.0f});
    addPart(p.x - 105, p.y + 34, -180, rnd(-25, 25), 0.3f, 6, sf::Color(255, 170, 50));
    playSfx(SF_MISSILE);
}

void updateCombat(float dt, float wdt, int level) {
    tEnemy -= wdt;
    if (tEnemy <= 0 && bossT <= 0 && anyAlive()) {
        int kind = (level >= 2 && rand() % 3 == 0) ? 1 : 0;
        float hp = (kind == 1) ? 4.f : 2.f;
        float spd = (kind == 1) ? -210.f : -270.f - level * 15.f;
        enemies.push_back({1140.f, rnd(90, 460), spd, 0.f, hp, hp, rnd(1.0f, 2.0f), kind});
        tEnemy = std::max(1.8f, 4.5f - level * 0.4f) * DIFF_WAIT[diff];
    }

    for (std::size_t i = 0; i < enemies.size();) {
        EnemyPlane& e = enemies[i];
        int target = 0;
        if (numPlayers == 2 && pl[1].alive && (!pl[0].alive || std::fabs(pl[1].y - e.y) < std::fabs(pl[0].y - e.y))) target = 1;
        if (pl[target].alive && e.x > pl[target].x - 30) {
            float dy = pl[target].y - e.y;
            float trackSpd = (e.kind == 1) ? 115.f : 155.f;
            e.vy += (std::clamp(dy * 2.5f, -trackSpd, trackSpd) - e.vy) * std::min(1.f, 4.f * wdt);
        }
        e.x += e.vx * wdt;
        e.y = std::clamp(e.y + e.vy * wdt, 55.f, 500.f);
        if (e.kind == 1) {
            e.shotCd -= wdt;
            if (e.shotCd <= 0 && e.x > 300 && e.x < 960) {
                e.shotCd = 1.6f;
                bullets.push_back({e.x - 55, e.y, -520.f, 0.f, -1, false, 2.5f});
                playSfx(SF_GUN);
            }
        }
        sf::FloatRect er({e.x - 46, e.y - 14}, {92, 28});
        bool hitP = false;
        for (int p = 0; p < 2; p++) {
            if (!pl[p].alive || pl[p].inv > 0) continue;
            if (touches(er, bodyBox(pl[p])) || touches(er, wingBox(pl[p]))) {
                hurtPlayer(p);
                hitP = true;
                break;
            }
        }
        if (hitP) {
            burst(e.x, e.y, 28, 300);
            addDebris(e.x, e.y, 6);
            addShock(e.x, e.y, 65.f, sf::Color(255, 160, 60));
            enemies.erase(enemies.begin() + i);
            continue;
        }
        if (e.x < -90) enemies.erase(enemies.begin() + i);
        else i++;
    }

    for (std::size_t i = 0; i < bullets.size();) {
        Bullet& b = bullets[i];
        b.life -= dt;
        if (b.missile && !enemies.empty()) {
            float bestD = 99999.f, ty = b.y;
            for (const EnemyPlane& e : enemies) {
                if (e.x < b.x) continue;
                float d = std::hypot(e.x - b.x, e.y - b.y);
                if (d < bestD) { bestD = d; ty = e.y; }
            }
            if (bestD < 600.f) b.vy += std::clamp((ty - b.y) * 5.f, -260.f, 260.f) * dt;
        }
        b.x += b.vx * dt;
        b.y += b.vy * dt;
        if (b.missile) addPart(b.x - 14, b.y, -120, rnd(-20, 20), 0.25f, 4, sf::Color(220, 220, 230, 190));

        bool eraseMe = (b.life <= 0 || b.x > 1060 || b.x < -40 || b.y < 0 || b.y > GROUND_Y);
        sf::FloatRect br = b.missile ? sf::FloatRect({b.x - 12, b.y - 5}, {24, 10}) : sf::FloatRect({b.x - 7, b.y - 3}, {14, 6});

        if (!eraseMe && b.owner >= 0) {
            for (std::size_t j = 0; j < enemies.size(); j++) {
                EnemyPlane& e = enemies[j];
                sf::FloatRect er({e.x - 46, e.y - 16}, {92, 32});
                if (touches(br, er)) {
                    e.hp -= b.missile ? 3.f : 1.f;
                    eraseMe = true;
                    if (b.missile) { burst(b.x, b.y, 24, 280); addShock(b.x, b.y, 70.f, sf::Color(255, 190, 60)); shake = std::max(shake, 0.25f); }
                    else addPart(b.x, b.y, rnd(-80, 80), rnd(-80, 80), 0.25f, 4, sf::Color(255, 220, 90));
                    if (e.hp <= 0) {
                        int pts = (doubleT > 0) ? 50 : 25;
                        score += pts;
                        addText(e.x, e.y - 20, "ENEMY DOWN +" + std::to_string(pts), sf::Color(255, 210, 60));
                        burst(e.x, e.y, 35, 340);
                        addDebris(e.x, e.y, 7);
                        addShock(e.x, e.y, 85.f, sf::Color(255, 120, 40));
                        playSfx(SF_CRASH);
                        for (int c = 0; c < 80; c++)
                            if (!cn[c].alive) { cn[c] = Coin{e.x, e.y, 0, true}; break; }
                        enemies.erase(enemies.begin() + j);
                    } else {
                        playSfx(SF_HIT);
                    }
                    break;
                }
            }
            if (!eraseMe) {
                for (std::size_t j = 0; j < obs.size(); j++) {
                    if (obs[j].type == O_DRONE && touches(br, obstacleBox(obs[j]))) {
                        int pts = (doubleT > 0) ? 30 : 15;
                        score += pts;
                        addText(obs[j].x, obs[j].y - 15, "DRONE +" + std::to_string(pts), sf::Color(150, 235, 255));
                        burst(obs[j].x + 20, obs[j].y + 10, 20, 240);
                        addDebris(obs[j].x + 20, obs[j].y + 10, 4);
                        playSfx(SF_HIT);
                        obs.erase(obs.begin() + j);
                        eraseMe = true;
                        break;
                    }
                }
            }
        } else if (!eraseMe && b.owner == -1) {
            for (int p = 0; p < 2; p++) {
                if (!pl[p].alive || pl[p].inv > 0) continue;
                if (touches(br, bodyBox(pl[p])) || touches(br, wingBox(pl[p]))) {
                    hurtPlayer(p);
                    eraseMe = true;
                    break;
                }
            }
        }
        if (eraseMe) bullets.erase(bullets.begin() + i);
        else i++;
    }
}

void drawCombat(sf::RenderWindow& w, sf::Font& font) {
    for (const EnemyPlane& e : enemies) {
        drawEnemyPlane(w, e.x, e.y, e.kind, e.hp / e.maxHp);
        if (e.x > 1000 && ((int)(bgTime * 12) % 2 == 0)) {
            ball(w, 976, e.y, 14, sf::Color(220, 35, 45, 210));
            ring(w, 976, e.y, 14, 2, sf::Color::White);
            center(w, font, "!", 18, 976, e.y, sf::Color::White);
        }
    }
    for (const Bullet& b : bullets) {
        if (b.owner == -1) {
            ball(w, b.x, b.y, 6, sf::Color(255, 60, 60, 110));
            ball(w, b.x, b.y, 3.5f, sf::Color(255, 190, 190));
        } else if (b.missile) {
            box(w, b.x - 12, b.y - 2.5f, 20, 5, sf::Color(240, 240, 245));
            float tip[] = {b.x + 8, b.y - 2.5f, b.x + 15, b.y, b.x + 8, b.y + 2.5f};
            poly(w, 3, tip, sf::Color(220, 40, 40));
            box(w, b.x - 12, b.y - 4.5f, 4, 9, sf::Color(90, 95, 105));
        } else {
            box(w, b.x - 8, b.y - 1.5f, 16, 3, sf::Color(255, 235, 90));
            box(w, b.x + 2, b.y - 1.f, 6, 2, sf::Color::White);
        }
    }
}
